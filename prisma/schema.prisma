// Prisma schema for the Softsuave Blog CMS.
// Prisma 7 uses the query compiler + driver adapters (no Rust engine binary),
// so the client is generated into src/generated/prisma and instantiated with
// a driver adapter (see src/lib/db.ts). Section 9 of the build spec defines the
// core models.
//
// ── MySQL notes (ported from Postgres) ───────────────────────────────────────
// 1. `String` maps to VARCHAR(191) on MySQL, where Postgres gave it TEXT. Every
//    field that can exceed that therefore carries an explicit `@db.` type —
//    without one, long content is REJECTED (strict mode) or truncated. Treat a
//    bare `String` here as a deliberate "this is short" assertion.
// 2. MySQL forbids a literal DEFAULT on TEXT/LONGTEXT columns. Fields that need
//    both a default and unbounded length (`contentHtml`) are therefore LONGTEXT
//    with the default applied in application code, not DDL.
// 3. Search is a real `searchText` column (HTML stripped at write time by
//    lib/content/service.ts) plus MySQL FULLTEXT indexes — see the Post model.
//    Unlike the Postgres tsvector column this is fully expressible in Prisma,
//    so `migrate` no longer needs hand-restored raw-SQL indexes.
// 4. Prisma creates tables as utf8mb4 / utf8mb4_unicode_ci, which is case- and
//    accent-INSENSITIVE. So `@unique` on slug/email now rejects case-variant
//    duplicates, and `contains` filters are case-insensitive without any query
//    flag — MySQL has no equivalent of Postgres' `mode: 'insensitive'`. Stricter
//    than Postgres was, and desirable for email.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ─────────────────────────── Enums ───────────────────────────

enum Role {
  ADMIN
  EDITOR
}

enum ContentStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
}

// ─────────────────────────── Users ───────────────────────────

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  name                String?
  passwordHash        String    @db.VarChar(255) // argon2id encoded hash
  role                Role      @default(EDITOR)

  // Public author profile (rendered in the author-bio box on posts).
  title           String? // e.g. "Founder & CEO"
  bio             String? @db.Text
  socialLinksJson Json? // [{ label, url }]
  avatarMediaId   String?
  avatar          Media?  @relation("UserAvatar", fields: [avatarMediaId], references: [id])

  twoFactorSecret     String?
  twoFactorEnabled    Boolean   @default(false)
  failedLoginAttempts Int       @default(0)
  lastFailedLoginAt   DateTime?
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  posts         Post[]         @relation("PostAuthor")
  pages         Page[]         @relation("PageAuthor")
  media         Media[]        @relation("MediaUploader")
  auditLogs     AuditLog[]
  refreshTokens RefreshToken[]

  @@index([role])
}

// Server-side refresh tokens enable rotation + reuse detection. Each login opens
// a token "family"; refreshing rotates the token within the family, and
// presenting an already-used/revoked token revokes the whole family (theft
// response). Only a SHA-256 hash of the JWT is stored.
model RefreshToken {
  id        String    @id @default(cuid()) // also the JWT `jti`
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId  String
  tokenHash String    @db.VarChar(64) // SHA-256, hex
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  ipAddress String?   @db.VarChar(45) // fits IPv6
  // User-Agent is attacker-controlled and routinely exceeds 191 chars. TEXT so a
  // long header is recorded rather than rejecting the login that carried it.
  userAgent String?   @db.Text
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

// ─────────────────────────── Posts ───────────────────────────

model Post {
  id    String @id @default(cuid())
  title String @db.VarChar(255)
  slug  String @unique @db.VarChar(255)

  contentJson Json
  // LONGTEXT: imported WordPress bodies run well past any VARCHAR. MySQL rejects
  // a literal DEFAULT on LONGTEXT, so the old `@default("")` lives in
  // lib/content/service.ts instead — every write path supplies a value.
  contentHtml String        @db.LongText
  excerpt     String?       @db.Text
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?

  authorId String
  author   User   @relation("PostAuthor", fields: [authorId], references: [id])

  coverImageId String?
  coverImage   Media?  @relation("PostCover", fields: [coverImageId], references: [id])

  // SEO
  seoTitle       String? @db.VarChar(255)
  seoDescription String? @db.Text
  ogImageId      String?
  ogImage        Media?  @relation("PostOg", fields: [ogImageId], references: [id])
  canonicalUrl   String? @db.Text
  noIndex        Boolean @default(false)

  readingTimeMinutes Int @default(0)
  wordCount          Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categories PostCategory[]
  tags       PostTag[]
  revisions  PostRevision[]

  // Full-text search source: `contentHtml` with tags stripped, written by
  // lib/content/service.ts. Indexing the raw HTML instead would pour tag names,
  // hrefs and CSS classes into the index and wreck relevance.
  searchText String @db.LongText

  // Two FULLTEXT indexes, not one: MySQL requires MATCH()'s column list to match
  // an index exactly, so ranking a title hit above a body hit needs its own
  // single-column index. lib/search/fulltext.ts scores
  // MATCH(all) + TITLE_BOOST * MATCH(title). More indexes would allow finer
  // weighting, but each one is maintained on every write.
  @@fulltext([title, excerpt, searchText])
  @@fulltext([title])
  @@index([status, publishedAt])
  @@index([authorId])
}

model PostRevision {
  id          String   @id @default(cuid())
  postId      String
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  title       String   @db.VarChar(255)
  excerpt     String?  @db.Text
  contentJson Json
  createdAt   DateTime @default(now())

  @@index([postId, createdAt])
}

// ─────────────────────────── Pages ───────────────────────────
// Same shape as Post, minus taxonomy (no categories/tags).

model Page {
  id    String @id @default(cuid())
  title String @db.VarChar(255)
  slug  String @unique @db.VarChar(255)

  contentJson Json
  contentHtml String        @db.LongText
  excerpt     String?       @db.Text
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?

  authorId String
  author   User   @relation("PageAuthor", fields: [authorId], references: [id])

  coverImageId String?
  coverImage   Media?  @relation("PageCover", fields: [coverImageId], references: [id])

  seoTitle       String? @db.VarChar(255)
  seoDescription String? @db.Text
  ogImageId      String?
  ogImage        Media?  @relation("PageOg", fields: [ogImageId], references: [id])
  canonicalUrl   String? @db.Text
  noIndex        Boolean @default(false)

  readingTimeMinutes Int @default(0)
  wordCount          Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  searchText String @db.LongText

  @@fulltext([title, excerpt, searchText])
  @@fulltext([title])
  @@index([status, publishedAt])
}

// ─────────────────────────── Taxonomy ───────────────────────────

model Category {
  id          String  @id @default(cuid())
  name        String  @db.VarChar(255)
  slug        String  @unique @db.VarChar(255)
  description String? @db.Text

  posts PostCategory[]
}

model Tag {
  id          String  @id @default(cuid())
  name        String  @db.VarChar(255)
  slug        String  @unique @db.VarChar(255)
  description String? @db.Text

  posts PostTag[]
}

model PostCategory {
  postId     String
  categoryId String
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([postId, categoryId])
  @@index([categoryId])
}

model PostTag {
  postId String
  tagId  String
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
}

// ─────────────────────────── Media ───────────────────────────

model Media {
  id       String @id @default(cuid())
  // Cloudinary/S3 URLs run long, so VARCHAR(1024) rather than the 191 default.
  // A full index on that exceeds InnoDB's 3072-byte key limit, hence the 191-char
  // prefix index — the WordPress importer looks media up by exact url once per
  // image, and the Cloudinary migration filters by url prefix.
  url      String @db.VarChar(1024)
  filename String @db.VarChar(255)
  // VARCHAR, not TEXT, specifically so `@default("")` is legal on MySQL.
  altText  String @default("") @db.VarChar(512)

  mimeType  String? @db.VarChar(255)
  width     Int?
  height    Int?
  sizeBytes Int     @default(0)
  // Resized/WebP variant descriptors: [{ label, url, width, height, format }]
  variantsJson Json?

  uploadedById String
  uploadedBy   User   @relation("MediaUploader", fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())

  coverForPosts      Post[]         @relation("PostCover")
  ogForPosts         Post[]         @relation("PostOg")
  coverForPages      Page[]         @relation("PageCover")
  ogForPages         Page[]         @relation("PageOg")
  logoForSettings    SiteSettings[] @relation("SettingsLogo")
  faviconForSettings SiteSettings[] @relation("SettingsFavicon")
  avatarForUsers     User[]         @relation("UserAvatar")

  @@index([uploadedById])
  @@index([url(length: 191)])
}

// ─────────────────────────── Redirects ───────────────────────────

model Redirect {
  id         String   @id @default(cuid())
  // 512 chars keeps the UNIQUE index at 2048 bytes, inside InnoDB's 3072 limit.
  fromPath   String   @unique @db.VarChar(512)
  toPath     String   @db.Text
  statusCode Int      @default(301)
  createdAt  DateTime @default(now())
}

// ─────────────────────────── Site settings ───────────────────────────
// Single-row table addressed by the fixed id "singleton".

model SiteSettings {
  id              String  @id @default("singleton")
  siteTitle       String  @default("Softsuave Blog") @db.VarChar(255)
  tagline         String? @db.Text
  siteDescription String? @db.Text
  accentColor     String  @default("#2563eb") @db.VarChar(32)
  fontChoice      String  @default("inter") @db.VarChar(64)
  // Keep in sync with DEFAULT_THEME in src/themes/registry.ts — a fresh install
  // seeds this row from the column default, so a mismatch silently ships the
  // wrong theme.
  activeTheme     String  @default("softsuave") @db.VarChar(64)
  socialLinksJson Json?
  analyticsSnippet String? @db.Text

  logoMediaId String?
  logo        Media?  @relation("SettingsLogo", fields: [logoMediaId], references: [id])

  faviconMediaId String?
  favicon        Media?  @relation("SettingsFavicon", fields: [faviconMediaId], references: [id])

  updatedAt DateTime @updatedAt
}

// ─────────────────────────── Audit log ───────────────────────────

model AuditLog {
  id           String   @id @default(cuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action       String   @db.VarChar(191)
  targetType   String?  @db.VarChar(191)
  targetId     String?  @db.VarChar(191)
  ipAddress    String?  @db.VarChar(45)
  userAgent    String?  @db.Text
  metadataJson Json?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([action])
}
